# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Neon: paste the connection string (pooled or direct). Leave unset for local SQLite.
# DATABASE_URL=
# The app connects to Neon's direct endpoint even if you paste the -pooler one: one process with its own
# small pool doesn't need PgBouncer, and skipping it halves the round trips per query. Set false to keep the pooler.
# DB_DIRECT=true
ADMIN_PASSCODE=change-me
# Optional: the shared password of the demo logins (default in onboarding/seeding.py). Signs vendor/employee cookies:
# DEMO_PASSWORD=
# SESSION_SECRET=
